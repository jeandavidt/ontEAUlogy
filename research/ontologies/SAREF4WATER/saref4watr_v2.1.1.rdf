    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/River">
    <rdfs:label xml:lang="en">River</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/SinkAsset"/>
    <rdfs:comment xml:lang="en">A river is a natural flowing watercourse, usually freshwater, flowing towards an ocean, sea, lake or another river.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Oxygen">
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/ChemicalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dissolved oxygen</rdfs:label>
