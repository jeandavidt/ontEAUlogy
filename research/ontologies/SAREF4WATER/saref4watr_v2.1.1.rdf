  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Lagoon">
    <rdfs:label xml:lang="en">Lagoon</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/SourceAsset"/>
    <rdfs:comment xml:lang="en">A lagoon is a shallow body of water separated from a larger body of water by barrier islands or reefs.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Aquifer">
    <rdfs:label xml:lang="en">Aquifer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/StorageAsset"/>
    <rdfs:comment xml:lang="en">An aquifer is an underground layer of water-bearing permeable rock, rock fractures or unconsolidated materials.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/forDayInMonth">
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4watr/TimeBasedTariff"/>
    <rdfs:label xml:lang="en">for day in month</rdfs:label>
    <rdfs:comment xml:lang="en">The day of the month for which a tariff is applied (e.g., each 15).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gDay"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/RawWater">
    <rdfs:label xml:lang="en">Raw water</rdfs:label>
    <rdfs:comment xml:lang="en">Raw water is water found in the environment that has not been treated and does not have any of its minerals, ions, particles, bacteria, or parasites removed.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/WaterKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3551588c4cf7474eb35251a428dc47c2b4">
    <owl:allValuesFrom rdf:resource="https://saref.etsi.org/saref4watr/WaterMeterProperty"/>
    <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Pit">
    <rdfs:label xml:lang="en">Pit</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/TransportAsset"/>
    <rdfs:comment xml:lang="en">A pit is a well or hole sunk in the ground to procure, store or drain water.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Stormwater">
    <rdfs:label xml:lang="en">Storm water</rdfs:label>
    <rdfs:comment xml:lang="en">Stormwater is water that originates during precipitation events and snow/ice melt.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/WaterKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfContains">
    <rdfs:label xml:lang="en">sfContains</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
