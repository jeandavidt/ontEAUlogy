    <rdfs:label xml:lang="en">Oxygen saturation</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its oxygen saturation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Humidity">
    <rdfs:label xml:lang="en">Humidity</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the environment indicating the humidity.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/EnvironmentalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Trichloroethene">
    <rdfs:label xml:lang="en">Trichloroethene</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its concentration of trichloroethene.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/ChemicalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Estuary">
    <rdfs:label xml:lang="en">Estuary</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/SinkAsset"/>
    <rdfs:comment xml:lang="en">An estuary is a partially enclosed coastal body of brackish water with one or more rivers or streams flowing into it, and with a free connection to the open sea.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/EnvironmentalProperty">
