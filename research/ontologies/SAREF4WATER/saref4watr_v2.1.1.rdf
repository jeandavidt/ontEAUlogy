    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/TransportAsset"/>
    <rdfs:comment xml:lang="en">An intake is an installation for obtaining water from a source of supply (river, lake, reservoir, and so on).</rdfs:comment>
