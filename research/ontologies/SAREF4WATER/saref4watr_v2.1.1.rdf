  <rdf:Description rdf:about="http://www.opengis.net/ont/sf#Point">
    <rdfs:label xml:lang="en">Point</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
