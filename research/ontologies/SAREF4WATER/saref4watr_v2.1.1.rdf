  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Main">
    <rdfs:label xml:lang="en">Main</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/TransportAsset"/>
    <rdfs:comment xml:lang="en">A main is a passage of water to flow through.</rdfs:comment>
