    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3551588c4cf7474eb35251a428dc47c2b7">
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4watr/hasHardwareVersion"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/forFinancialConsumption">
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4watr/ConsumptionBasedTariff"/>
    <rdfs:label xml:lang="en">for financial consumption</rdfs:label>
    <rdfs:comment xml:lang="en">The financial consumption related to a tariff (e.g., prepaid tariffs).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/">
    <owl:priorVersion rdf:resource="https://saref.etsi.org/saref4watr/v1.1.1/"/>
    <rdfs:seeAlso rdf:resource="https://www.etsi.org/deliver/etsi_ts/103400_103499/10341010/02.01.01_60/ts_10341010v020101p.pdf"/>
    <vann:preferredNamespacePrefix>s4watr</vann:preferredNamespacePrefix>
    <dcterms:creator rdf:resource="http://www.garcia-castro.com/foaf.rdf#me"/>
    <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1/"/>
    <owl:imports rdf:resource="https://saref.etsi.org/saref4syst/v1.1.2/"/>
    <owl:imports rdf:resource="https://saref.etsi.org/saref4city/v2.1.1/"/>
    <dcterms:title xml:lang="en">SAREF4WATR: an extension of SAREF for the water domain</dcterms:title>
    <dcterms:publisher rdf:resource="https://www.etsi.org/"/>
    <vann:preferredNamespaceUri>https://saref.etsi.org/saref4watr/</vann:preferredNamespaceUri>
    <owl:versionInfo>v2.1.1</owl:versionInfo>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-25</dcterms:issued>
    <dcterms:source rdf:resource="https://saref.etsi.org/sources/saref4watr/"/>
    <owl:versionIRI rdf:resource="https://saref.etsi.org/saref4watr/v2.1.1/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-24</dcterms:modified>
    <dcterms:description xml:lang="en">This ontology extends the SAREF ontology for the water domain. This work has been developed in the context of the STF 566, which was established with the goal to create three SAREF extensions, one of them for the water domain.</dcterms:description>
    <dcterms:license rdf:resource="https://forge.etsi.org/etsi-software-license"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/AcceptabilityProperty">
    <rdfs:label xml:lang="en">Acceptability property</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/WaterProperty"/>
    <rdfs:comment xml:lang="en">An acceptability property is a property of water that is related to its acceptability.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Benzene">
    <rdfs:label xml:lang="en">Benzene</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its concentration of benzene.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/ChemicalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3551588c4cf7474eb35251a428dc47c2b8">
    <owl:someValuesFrom rdf:resource="https://saref.etsi.org/saref4watr/WaterFlowProperty"/>
    <owl:onProperty rdf:resource="https://saref.etsi.org/core/observes"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/WaterUse">
    <rdfs:label xml:lang="en">Water use</rdfs:label>
    <rdfs:comment xml:lang="en">This class is used to define the different uses of water.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Sulphate">
    <rdfs:label xml:lang="en">Sulphate</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its concentration of sulphate.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/ChemicalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/BatteryOperatingTime">
    <rdfs:label xml:lang="en">Battery operating time</rdfs:label>
    <rdfs:comment xml:lang="en">The time for which the battery has been operating since the last charge.</rdfs:comment>
