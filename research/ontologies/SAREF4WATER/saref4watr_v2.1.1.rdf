  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Tariff">
    <rdfs:label xml:lang="en">Tariff</rdfs:label>
    <rdfs:comment xml:lang="en">A tariff is a schedule of rates or charges of a business or a public utility. Tariffs can be based on time, thresholds or consumption; however, combined tariffs may also exist that mix more than one of these types.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Vent">
    <rdfs:label xml:lang="en">Vent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/TransportAsset"/>
    <rdfs:comment xml:lang="en">A vent is the part of a system that allows air to enter a plumbing system to maintain proper air pressure and sewer gases to escape to the outside.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/TotalOrganicCarbon">
    <rdfs:label xml:lang="en">TOC</rdfs:label>
    <rdfs:label xml:lang="en">Total organic carbon</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its concentration of total organic carbon.</rdfs:comment>
