    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/MicrobialProperty"/>
    <rdfs:comment xml:lang="en">A bacterial property is a property of water that is related to bacteria.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
