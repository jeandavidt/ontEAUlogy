  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Sea">
    <rdfs:label xml:lang="en">Sea</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4watr/SinkAsset"/>
    <rdfs:comment xml:lang="en">A sea is a body of salt water partly or fully enclosed by land.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Aluminium">
    <rdfs:label xml:lang="en">Aluminium</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its concentration of aluminium.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/ChemicalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Colour">
    <rdfs:label xml:lang="en">Colour</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its colour.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/AcceptabilityProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
