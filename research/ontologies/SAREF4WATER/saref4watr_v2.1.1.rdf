    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Hardness">
    <rdfs:label xml:lang="en">Hardness</rdfs:label>
