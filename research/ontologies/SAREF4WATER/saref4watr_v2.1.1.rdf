    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/ColonyCount37C">
    <rdfs:label xml:lang="en">Colony count at 37 °C</rdfs:label>
    <rdfs:comment xml:lang="en">Property of the water indicating its colony count at 37 ºC.</rdfs:comment>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4watr/BacterialProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
