    geo:long "3.730"^^xsd:double .

# WWTP-2 Inlet Water Quality Sensor
ghent:WWTP2_Inlet_WaterQuality_Sensor a wf:WaterQualitySensor, sosa:Sensor ;
    rdfs:label "WWTP-2 Inlet Water Quality Sensor"@en ;
    rdfs:comment "Multi-parameter water quality sensor monitoring WWTP-2 influent"@en ;
    sosa:observes wf:BOD, wf:COD, wf:TSS, wf:NH4 ;
