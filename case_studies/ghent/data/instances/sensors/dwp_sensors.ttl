    sosa:observes wf:Turbidity, wf:Chlorine, wf:pH ;
    wf:monitorsPort ghent:DWP2_PotableWater_Out ;
    wf:attachedTo ghent:DWP2 ;
    wf:hasSamplingRate "1.0"^^xsd:double ;
    geo:lat "51.049"^^xsd:double ;
    geo:long "3.725"^^xsd:double .

# DWP-2 Inlet Water Quality Sensor
ghent:DWP2_Inlet_WaterQuality_Sensor a wf:WaterQualitySensor, sosa:Sensor ;
    rdfs:label "DWP-2 Inlet Water Quality Sensor"@en ;
    rdfs:comment "Multi-parameter water quality sensor monitoring DWP-2 raw water inlet"@en ;
    sosa:observes wf:Turbidity, wf:BOD, wf:pH ;
    wf:monitorsPort ghent:DWP2_RawWater_In ;
    wf:attachedTo ghent:DWP2 ;
    wf:hasSamplingRate "1.0"^^xsd:double ;
    geo:lat "51.049"^^xsd:double ;
    geo:long "3.723"^^xsd:double .
